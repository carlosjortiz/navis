{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Navis",
  "version": "0.0.0",
  "identifier": "io.github.carlosjortiz.navis",
  "build": {
    "frontendDist": "../../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "workspace-selector",
        "title": "Navis — Workspace Selector",
        "url": "workspace-selector.html",
        "width": 600,
        "height": 400,
        "visible": true
      },
      {
        "label": "main",
        "title": "Navis",
        "url": "/",
        "width": 1280,
        "height": 800,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
